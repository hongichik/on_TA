// ============================================================
// Trắc nghiệm - Google Apps Script backend
// Dán toàn bộ file này vào Extensions > Apps Script của Google Sheet,
// chạy hàm setup() một lần, rồi Deploy > New deployment > Web app.
// ============================================================

const QUESTIONS_SHEET = 'Questions';
const STATS_SHEET = 'WrongStats';

// Chạy hàm này 1 LẦN (Run > setup) để tạo 2 sheet và nạp sẵn 246 câu hỏi.
function setup() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();

  let qSheet = ss.getSheetByName(QUESTIONS_SHEET);
  if (!qSheet) qSheet = ss.insertSheet(QUESTIONS_SHEET);
  qSheet.clear();
  qSheet.appendRow(['ID', 'Question', 'Option 1', 'Option 2', 'Option 3', 'Option 4', 'Correct Answer', 'Description']);
  qSheet.getRange(2, 1, SEED_QUESTIONS.length, 8).setValues(SEED_QUESTIONS);
  qSheet.setFrozenRows(1);
  qSheet.autoResizeColumns(1, 8);

  let sSheet = ss.getSheetByName(STATS_SHEET);
  if (!sSheet) sSheet = ss.insertSheet(STATS_SHEET);
  sSheet.clear();
  sSheet.appendRow(['ID', 'Attempts', 'Wrongs', 'LastWrongAt']);
  sSheet.setFrozenRows(1);

  SpreadsheetApp.getUi().alert(
    'Đã khởi tạo xong!\nSheet "Questions": ' + SEED_QUESTIONS.length + ' câu.\nSheet "WrongStats": sẵn sàng ghi thống kê.\n\nBây giờ vào Deploy > New deployment > Web app để lấy URL.'
  );
}

function doGet(e) {
  const action = ((e && e.parameter && e.parameter.action) || 'questions').toLowerCase();
  if (action === 'wrongstats') {
    return jsonOutput_(getWrongStats_());
  }
  return jsonOutput_(getQuestions_());
}

function doPost(e) {
  try {
    const body = JSON.parse(e.postData.contents);
    if (body.action === 'report') {
      reportAnswer_(body.id, !!body.correct);
      return jsonOutput_({ ok: true });
    }
    return jsonOutput_({ ok: false, error: 'unknown action' });
  } catch (err) {
    return jsonOutput_({ ok: false, error: String(err) });
  }
}

function getQuestions_() {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(QUESTIONS_SHEET);
  if (!sheet) return [];
  // getDisplayValues() thay vì getValues(): lấy đúng chuỗi text hiển thị trong ô,
  // tránh Sheets tự suy diễn số/ngày giờ (vd "9:30" bị đọc thành đối tượng Date).
  const values = sheet.getDataRange().getDisplayValues();
  const rows = values.slice(1);
  const out = [];
  rows.forEach((row, i) => {
    const [id, question, o1, o2, o3, o4, answer, desc] = row;
    if (!question) return;
    const options = [o1, o2, o3, o4].filter(function (v) { return v !== '' && v !== null && v !== undefined; });
    out.push({
      id: id || (i + 1),
      q: question,
      options: options,
      answer: answer,
      desc: desc || ''
    });
  });
  return out;
}

function getWrongStats_() {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(STATS_SHEET);
  if (!sheet) return [];
  const values = sheet.getDataRange().getDisplayValues();
  const rows = values.slice(1);
  const out = [];
  rows.forEach(function (row) {
    const id = row[0], attempts = row[1], wrongs = row[2], lastWrongAt = row[3];
    if (!id) return;
    out.push({ id: id, attempts: attempts || 0, wrongs: wrongs || 0, lastWrongAt: lastWrongAt ? String(lastWrongAt) : '' });
  });
  return out;
}

function reportAnswer_(id, correct) {
  if (!id) return;
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(STATS_SHEET);
  if (!sheet) return;
  const values = sheet.getDataRange().getValues();
  let rowIndex = -1;
  for (let i = 1; i < values.length; i++) {
    if (String(values[i][0]) === String(id)) { rowIndex = i + 1; break; }
  }
  if (rowIndex === -1) {
    sheet.appendRow([id, 1, correct ? 0 : 1, correct ? '' : new Date()]);
  } else {
    const attempts = (values[rowIndex - 1][1] || 0) + 1;
    const wrongs = (values[rowIndex - 1][2] || 0) + (correct ? 0 : 1);
    sheet.getRange(rowIndex, 2).setValue(attempts);
    sheet.getRange(rowIndex, 3).setValue(wrongs);
    if (!correct) sheet.getRange(rowIndex, 4).setValue(new Date());
  }
}

function jsonOutput_(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON);
}
